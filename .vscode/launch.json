{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar Editor3D (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\bin\\Editor3D.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\MinGW\\bin\\gdb.exe",
            "setupCommands": [
                { "description": "Formato legible", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Compilar (Debug)"
        }
    ]
}
